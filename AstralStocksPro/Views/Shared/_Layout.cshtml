@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OptionTrader</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: #0b1220;
            color: #dbe2f1;
        }

        .sidebar {
            width: 240px;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            background: #0f172a;
            padding: 1rem;
        }

        .sidebar a {
            color: #b7c2d7;
            display: block;
            padding: .5rem .75rem;
            border-radius: .5rem;
            text-decoration: none;
        }

        .sidebar a.active,
        .sidebar a:hover {
            background: #1e293b;
            color: #fff;
        }

        .content {
            margin-left: 260px;
            padding: 1.25rem;
        }

        .card {
            background: #111827;
            color: #dbe2f1;
            border: 1px solid #1f2937;
        }

        .table {
            color: #dbe2f1;
        }

        .table thead {
            color: #9fb0ca;
        }

        .atm-row {
            background: #0b2e13 !important;
        }

        .call {
            color: #65f0a5;
        }

        .put {
            color: #ff7b7b;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h5>OptionTrader</h5>
        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        <a asp-controller="Chain" asp-action="Index" asp-route-symbol="NIFTY">Chain</a>
        <a asp-controller="Signals" asp-action="Index">Signals</a>
        <a asp-controller="Orders" asp-action="Index">Orders</a>
        <a asp-controller="Positions" asp-action="Index">Positions</a>
        <a asp-controller="Strategies" asp-action="Index">Strategies</a>
        <a asp-controller="Backtests" asp-action="Index">Backtests</a>
        <a asp-controller="Risk" asp-action="Index">Risk</a>
        <a asp-controller="Settings" asp-action="Index">Settings</a>
        <a asp-controller="Logs" asp-action="Index">Logs</a>
    </div>
    <div class="content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>